{
  "name": "@asmadsen/opencode-node-package-manager",
  "version": "0.1.0",
  "description": "Opencode plugin that intercepts package manager commands and rewrites them to use the correct package manager",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "package-manager",
    "npm",
    "pnpm",
    "yarn",
    "bun"
  ],
  "license": "MIT",
  "packageManager": "bun@1.2.18",
  "devDependencies": {
    "@opencode-ai/plugin": "^1.3.14",
    "@total-typescript/tsconfig": "^1.0.4",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
